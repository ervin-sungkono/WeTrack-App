{
  "name": "wetrack-app",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "migrate:firebase-access": "node --env-file-if-exists=.env.local --import tsx --conditions=react-server scripts/migrate-firebase-access.ts",
    "smoke": "node --import tsx scripts/smoke-app.ts",
    "migrate:attachment-privacy": "node --env-file-if-exists=.env.local --import tsx --conditions=react-server scripts/migrate-attachment-privacy.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@hello-pangea/dnd": "18.0.1",
    "@tanstack/react-table": "^8.9.3",
    "@yaireo/tagify": "4.39.0",
    "chart.js": "^4.4.2",
    "file-saver": "^2.0.5",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "flowbite": "^2.2.1",
    "formik": "^2.4.5",
    "jszip": "^3.10.1",
    "moment": "^2.30.1",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "nodemailer": "10.1.2",
    "openai": "^4.32.1",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^4.10.1",
    "react-loader-spinner": "8.0.2",
    "react-markdown": "10.1.0",
    "react-mentions": "^4.4.10",
    "react-syntax-highlighter": "16.1.2",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "usehooks-ts": "3.1.1",
    "yup": "^1.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.2",
    "@types/file-saver": "^2",
    "@types/node": "^24",
    "@types/nodemailer": "^7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-mentions": "^4",
    "@types/react-syntax-highlighter": "^15",
    "autoprefixer": "^10",
    "encoding": "^0.1.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8",
    "sass": "^1.70.0",
    "tailwindcss": "^3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "@babel/runtime": "^7.29.10",
    "postcss-selector-parser": "^7.1.6",
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
