# Authentication. Generate a random NEXTAUTH_SECRET; never commit its value.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Firebase browser configuration (public identifiers, not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server-only: standard downloaded service account JSON (one-line JSON).
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a file outside the repo.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional overrides; otherwise the public project ID/bucket above are used.
# FIREBASE_PROJECT_ID=""
# FIREBASE_STORAGE_BUCKET=""

# Existing Gmail SMTP account for verification and invitation messages.
EMAIL=""
EMAIL_PASS=""

# Existing server-side AI feature. Optional unless AI features are used.
CHATGPT_SECRET_KEY=""
# Fixed UTC windows shared by all AI endpoints per authenticated account.
AI_REQUESTS_PER_MINUTE="6"
AI_REQUESTS_PER_DAY="60"
